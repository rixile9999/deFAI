{
  "folders": [
    {
      "name": "Transformer 기반 멀티모달 학습 모델",
      "path": "."
    },
    {
      "name": "공통 기반",
      "path": "../../common"
    }
  ],
  "settings": {
    "python.analysis.extraPaths": [
      "../../common/src"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "실행",
        "type": "process",
        "command": "${command:python.interpreterPath}",
        "args": [
          "${workspaceFolder}/run.py"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      }
    ]
  }
}
